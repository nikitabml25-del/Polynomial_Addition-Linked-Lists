# Enter Polynomial 1
p1 = {}

n = int(input("Enter number of terms in Polynomial 1: "))
for i in range(n):
    power = int(input("Enter power: "))
    coefficient = int(input("Enter coefficient: "))
    p1[power] = coefficient

# Enter Polynomial 2
p2 = {}
n = int(input("\nEnter number of terms in Polynomial 2: "))
for i in range(n):
    power = int(input("Enter power: "))
    coefficient = int(input("Enter coefficient: "))
    p2[power] = coefficient

# Add the polynomials
result = p1.copy()
for power in p2:
    if power in result:
        result[power] = result[power] + p2[power]
    else:
        result[power] = p2[power]

# Display result
print("\nResult:")
for power in sorted(result, reverse=True):
    print(result[power], "x^", power, end=" + ")

